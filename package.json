{
  "name": "bloglist-backend",
  "version": "1.0.0",
  "description": "Full Stack Open Part 11 - Exercise 21 Backend",
  "main": "index.js",

  "scripts": {
    "start:backend": "cross-env NODE_ENV=production node index.js",
    "start-test:backend": "cross-env NODE_ENV=test node --watch index.js",
    "dev:backend": "cross-env NODE_ENV=development node --watch index.js",
    "test:backend": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "lint:backend": "eslint .",

    "build:frontend": "pnpm --dir frontend run build",
    "lint:frontend": "pnpm --dir frontend run lint",
    "test-vitest:frontend": "pnpm --dir frontend run test-vitest",
    "test:frontend": "pnpm --dir frontend run test",
    "test-report:frontend": "pnpm --dir frontend run test-report"
  },

  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "supertest": "^7.2.2"
  }
}
